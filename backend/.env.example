# Server Configuration
NODE_ENV=development
PORT=3001
HOST=localhost

# Tableau Server Configuration
TABLEAU_SERVER_URL=https://tableau.company.com
TABLEAU_API_VERSION=3.22
TABLEAU_SITE_ID=

# Tableau Authentication
TABLEAU_PAT_NAME=your-pat-name
TABLEAU_PAT_SECRET=your-pat-secret
TABLEAU_USERNAME=your-username

# Security
JWT_SECRET=your-jwt-secret-key-change-this
SESSION_SECRET=your-session-secret-change-this

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,https://localhost:8443

# File Storage
TEMP_WORKBOOK_PATH=./temp-workbooks
TEMP_EXPORT_PATH=./temp-exports
MAX_FILE_SIZE=104857600
FILE_RETENTION_MINUTES=30

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=./logs

# VizQL Configuration
VIZQL_MAX_ROWS=100000
VIZQL_TIMEOUT_MS=30000

# Excel Export Configuration
EXCEL_MAX_ROWS=1048576
EXCEL_COMPRESSION=true

# Performance
WORKER_THREADS=4
ENABLE_CLUSTERING=false
